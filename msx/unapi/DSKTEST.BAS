10 ' FujiNet DSKIO test
20 CLEAR 200,&H8FFF
30 FOR I=0 TO 140:READ A:POKE &H9400+I,A:NEXT
40 DR=0:SC=0 ' drive 0 = FujiNet D1, sector 0
50 POKE &H9311,DR:POKE &H9312,SC AND 255:POKE &H9313,INT(SC/256)
60 FOR I=0 TO 511:POKE &H9000+I,&HE5:NEXT
70 DEFUSR=&H9400:X=USR(0)
80 S=PEEK(&H9300)
90 IF S=255 THEN PRINT "FujiNet ROM not found":END
100 PRINT "Found in slot";S
110 IF PEEK(&H9301)=0 THEN 140
120 PRINT "DSKIO failed, error";PEEK(&H9302);"sectors left";PEEK(&H9303)
130 END
140 PRINT "DSKIO ok - first 64 bytes:"
150 FOR I=0 TO 63
160 PRINT RIGHT$("0"+HEX$(PEEK(&H9000+I)),2);" ";
170 NEXT:PRINT
180 C=0:FOR I=0 TO 511:IF PEEK(&H9000+I)=&HE5 THEN C=C+1
190 NEXT
200 PRINT "bytes still holding the fill:";C
